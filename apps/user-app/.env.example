EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
EXPO_PUBLIC_SUI_NETWORK=testnet
EXPO_PUBLIC_ENOKI_API_KEY=your-enoki-public-api-key
EXPO_PUBLIC_ZKLOGIN_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
EXPO_PUBLIC_ZKLOGIN_SALT_FUNCTION=zklogin-salt
# Optional Enoki overrides:
# EXPO_PUBLIC_ENOKI_API_URL=https://api.enoki.mystenlabs.com
# EXPO_PUBLIC_ENOKI_ADDITIONAL_EPOCHS=2
# Optional Walrus upload overrides:
# EXPO_PUBLIC_WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
# EXPO_PUBLIC_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
# EXPO_PUBLIC_WALRUS_EPOCHS=5
# Required for Seal dataset encryption:
# EXPO_PUBLIC_MODI_SEAL_PACKAGE_ID=0xc5be8a456d0ba7d33fbcff12e92d73181a3817872f6598f5cea65a5326ab3e21
# Optional Seal key server overrides. Defaults to Mysten's testnet decentralized key server.
# EXPO_PUBLIC_SEAL_KEY_SERVER_CONFIGS=[{"objectId":"0xb012378c9f3799fb5b1a7083da74a4069e3c3f1c93de0b27212a5799ce1e1e98","aggregatorUrl":"https://seal-aggregator-testnet.mystenlabs.com","weight":1}]
# EXPO_PUBLIC_SEAL_THRESHOLD=1
# EXPO_PUBLIC_SEAL_VERIFY_KEY_SERVERS=false
# Optional platform-specific overrides:
# iOS OAuth redirect URI: com.modi.userapp:/oauthredirect
# EXPO_PUBLIC_ZKLOGIN_GOOGLE_IOS_CLIENT_ID=your-ios-google-oauth-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_ZKLOGIN_GOOGLE_ANDROID_CLIENT_ID=your-android-google-oauth-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_ZKLOGIN_GOOGLE_WEB_CLIENT_ID=your-web-google-oauth-client-id.apps.googleusercontent.com
